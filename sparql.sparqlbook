    "kind": 2,
    "language": "sparql",
    "value": "prefix d: <https://expertise.matdata.eu/#/page/>\r\n\r\nprefix skos: <http://www.w3.org/2004/02/skos/core#>\r\n\r\nselect ?category ?categoryUri WHERE {\r\n    ?s d:has-category ?category\r\n    FILTER(isLiteral(?category))\r\n\r\n    BIND(URI(LCASE(REPLACE(REPLACE(REPLACE(str(?category), \"/\", \"-\"), \" \", \"-\"), \"&\", \"and\"))) AS ?categoryUri)\r\n}\r\nGROUP BY ?category ?categoryUri",
