  {
    "kind": 2,
    "language": "sparql",
    "value": "prefix d: <https://expertise.matdata.eu/#/page/>\r\n\r\nprefix skos: <http://www.w3.org/2004/02/skos/core#>\r\n\r\nconstruct {\r\n    ?category skos:inScheme d:TechniqueCategories ;\r\n} \r\nwhere{\r\n    ?s a d:Technique;\r\n        d:has-category ?category\r\n}\r\nGROUP BY ?category",
