    "language": "sparql",
    "value": "prefix d: <https://expertise.matdata.eu/#/page/>\r\n\r\nselect * where \r\n{\r\n    ?s d:type d:Project;\r\n       d:hasTitle ?title;\r\n       d:hasDescription ?description;    \r\n}",
