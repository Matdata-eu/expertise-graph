d:proficiency-novice a skos:Concept ;
    skos:definition "Rigid adherence to taught rules or plans; little situational perception; no discretionary judgment" ;
    skos:inScheme d:ProficiencyLevels ;
    skos:prefLabel "Novice" .

d:proficiency-advanced-beginner a skos:Concept ;
    skos:definition "Guidelines for action based on attributes or aspects; situational perception still limited; all attributes and aspects are treated separately and given equal importance" ;
    skos:inScheme d:ProficiencyLevels ;
    skos:prefLabel "Advanced beginner" .

d:proficiency-competent a skos:Concept ;
    skos:definition "Conscious deliberate planning; standardized and routinized procedures; sees actions at least partially in terms of longer-term goals" ;
    skos:inScheme d:ProficiencyLevels ;
    skos:prefLabel "Competent" .

d:proficiency-proficient a skos:Concept ;
    skos:definition "Sees situations holistically rather than in terms of aspects; sees what is most important in a situation; perceives deviations from the normal pattern; decision-making less labored; uses maxims for guidance, whose meaning varies according to the situation" ;
    skos:inScheme d:ProficiencyLevels ;
    skos:prefLabel "Proficient" .

d:proficiency-expert a skos:Concept ;
    skos:definition "No longer relies on rules, guidelines, or maxims; intuitive grasp of situations based on deep tacit understanding; analytic approaches used only in novel situations or when problems occur; vision of what is possible" ;
    skos:inScheme d:ProficiencyLevels ;
    skos:prefLabel "Expert" .

d:ProficiencyLevels a skos:ConceptScheme ;
    rdfs:label "Dreyfus model of skill acquisition" .

d:ProjectCategories a skos:ConceptScheme ;
    rdfs:label "Categories of projects" .

d:TechniqueCategories a skos:ConceptScheme ;
    rdfs:label "Categories of techniques and tools" .

d:RoleCategories a skos:ConceptScheme ;
    rdfs:label "Categories of roles" .

    
d:category-data-and-it-role skos:prefLabel "Data & IT role" ;
	skos:inScheme d:RoleCategories ;
	a skos:Concept .
    
d:category-leading-roles skos:prefLabel "Leading roles" ;
	skos:inScheme d:RoleCategories ;
	a skos:Concept .
